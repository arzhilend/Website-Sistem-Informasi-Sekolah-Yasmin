# Application Config
APP_NAME="SMA Mutiara Insan Nusantara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Decoupled Frontend URL (Vercel / Local)
# Masukkan domain frontend (pisahkan koma jika lebih dari satu)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

# Database
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database

# Filesystem / Storage (Uploads)
FILESYSTEM_DISK=public

# Mail (Resend)
MAIL_MAILER=resend
RESEND_API_KEY=your_resend_api_key
MAIL_FROM_ADDRESS=noreply@sma-mutiarainsannusantara.my.id
MAIL_FROM_NAME="${APP_NAME}"
