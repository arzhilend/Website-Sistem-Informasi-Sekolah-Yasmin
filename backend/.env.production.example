# =======================================================
# LARAVEL BACKEND API - PRODUCTION CONFIGURATION
# (Deploy ke VPS / Cloud / Forge / Serverless)
# =======================================================

APP_NAME="SMA Mutiara Insan Nusantara"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# URL Domain Backend Laravel (Tempat API dan Media /storage diakses)
# Contoh: https://api.sma-mutiarainsannusantara.sch.id
APP_URL=https://api.yourdomain.com

# URL Frontend di Vercel (PENTING untuk CORS)
# Contoh: https://your-project.vercel.app atau https://sma-mutiarainsannusantara.sch.id
# Bisa multiple domain dipisahkan koma:
FRONTEND_URL=https://your-project.vercel.app

# Sanctum Stateful Domains (Opsional jika ingin session cookie di samping Bearer token)
SANCTUM_STATEFUL_DOMAINS=your-project.vercel.app

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database

# Filesystem / Storage (Uploads)
# Pastikan jalankan: php artisan storage:link di server produksi
FILESYSTEM_DISK=public

# Mail (Resend)
MAIL_MAILER=resend
RESEND_API_KEY=your_resend_api_key
MAIL_FROM_ADDRESS=noreply@sma-mutiarainsannusantara.my.id
MAIL_FROM_NAME="${APP_NAME}"
