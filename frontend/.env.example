# Backend Laravel API URL
# Untuk local development (sesuaikan dengan URL Laravel lokal Anda, contoh: http://localhost:8000 atau http://profil-yasmin.test)
VITE_API_BASE_URL=http://localhost:8000

# Untuk deployment di Vercel:
# Set environment variable di Vercel Dashboard -> Settings -> Environment Variables:
# VITE_API_BASE_URL=https://api.yourdomain.com
